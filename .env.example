# Circle Facilitator Service (x402 on Arc). Keys from https://console.circle.com, one per network.
AGENTPOS_ARC_FACILITATOR_URL=https://api.circle.com/v1/facilitator/x402
AGENTPOS_ARC_FACILITATOR_API_KEY_TESTNET=
AGENTPOS_ARC_FACILITATOR_API_KEY_MAINNET=
# Optional: an Arc RPC to verify smart-account (ERC-1271) wallet proofs. Public: https://rpc.testnet.arc.io
AGENTPOS_ARC_RPC_URL=
# Arc TESTNET wallets for the e2e (test money only). Fund the buyer at https://faucet.circle.com
ARC_TESTNET_BUYER_PRIVATE_KEY=
ARC_TESTNET_BUYER_ADDRESS=
ARC_TESTNET_MERCHANT_ADDRESS=

# Circle Wallets (developer-controlled) for the buyer agent on Arc testnet: the agent signs
# through Circle and holds no private key. Create the key and register the entity secret at
# console.circle.com, then run `pnpm --filter @agentpos/rail-arc circle-wallet:setup`.
CIRCLE_WALLETS_API_KEY_TESTNET=
CIRCLE_ENTITY_SECRET=
CIRCLE_BUYER_WALLET_ID=
CIRCLE_BUYER_WALLET_ADDRESS=
