    "lint": "eslint src"
  },
  "dependencies": {
    "@agentpos/core": "^0.2.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@stellar/stellar-sdk": "^16.3.1"
  }
