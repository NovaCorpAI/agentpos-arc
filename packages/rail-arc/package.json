{
  "name": "@agentpos/rail-arc",
  "version": "0.1.1",
  "description": "AgentPOS payment rail for Arc: x402 checkout in USDC on Circle's Arc network, settled by the Circle Facilitator Service straight to the merchant's wallet.",
  "license": "Apache-2.0",
  "homepage": "https://agentposhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaCorpAI/agentpos-arc.git",
    "directory": "packages/rail-arc"
  },
  "bugs": {
    "url": "https://github.com/NovaCorpAI/agentpos-arc/issues"
  },
  "keywords": [
    "agentpos",
    "x402",
    "arc",
    "circle",
    "usdc",
    "agentic-commerce",
    "payments"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src",
    "e2e:arc-testnet": "tsx scripts/e2e-arc-testnet.ts",
    "e2e:arc-woo": "tsx scripts/e2e-arc-woo.ts",
    "e2e:arc-buyer": "tsx scripts/e2e-arc-buyer.ts",
    "ci:wallet": "tsx scripts/ci-wallet.ts",
    "buy:arc": "tsx scripts/buy-on-arc.ts"
  },
  "dependencies": {
    "@agentpos/core": "^0.1.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@stellar/stellar-sdk": "^16.3.1",
    "@agentpos/site": "^0.1.5",
    "@x402/fetch": "2.28.0",
    "tsx": "^4.20.6",
    "@agentpos/connectors": "^0.1.5",
    "@agentpos/mcp-buyer": "^0.1.5",
    "@agentpos/scanner": "^0.1.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
